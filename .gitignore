# Akira SASE Cyberwar MVP - .gitignore

# ===================================
# SECURITY & CREDENTIALS
# ===================================
# Environment variables and secrets
.env
.env.local
.env.production
.env.staging
.env.development

# API Keys and credentials
**/api_keys.json
**/credentials.json
firebase-credentials.json
firebase-admin-sdk.json
openai-key.txt
secrets/
keys/
certs/

# Configuration files with sensitive data
