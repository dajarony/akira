*.tar.xz
*.rar
*.7z

# Temporary files
*.tmp
*.temp

# Lock files
*.lock

# PID files
*.pid

# Socket files
*.sock

# Core dumps (Unix core files, not the core/ directory)
core.[0-9]*

# ===================================
# PROJECT SPECIFIC EXCLUSIONS
# ===================================
# Exclude specific test files that might contain sensitive data
test_credentials.py
test_secrets.py

# Exclude local configuration overrides
local_config.py
dev_settings.py

# Exclude any files with 'secret' or 'private' in the name
*secret*
*private*
*confidential*

# Exclude compiled binaries
*.exe
*.dll
*.so
*.dylib

# Exclude large data files
*.csv
*.json.gz
*.parquet

# ===================================
# KEEP THESE FILES (NEGATIVE PATTERNS)
# ===================================
# Keep example configuration files
!.env.example
!config.example.json
!firebase-credentials.example.json

# Keep empty directories with .gitkeep
!.gitkeep

# Keep important documentation
!README*.md
!CHANGELOG.md
!LICENSE
!CONTRIBUTING.md

# Keep requirements files
!requirements*.txt
!Pipfile
!pyproject.toml

# Keep Docker files
!Dockerfile*
!docker-compose*.yml
!.dockerignore

# Keep CI/CD files
!.github/
!.gitlab-ci.yml
!.travis.yml
!.circleci/

# ===================================
# END OF .gitignore
# ===================================