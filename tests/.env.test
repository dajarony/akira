# Test Environment Configuration
# Configuración mínima para tests

# OpenAI Configuration
OPENAI_API_KEY=sk-test-fake-key-for-testing

# Firebase Configuration
FIREBASE_PROJECT_ID=akira-test
FIREBASE_CREDENTIALS_PATH=firebase-credentials-test.json

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_TO_CONSOLE=false
LOG_TO_FILE=false
LOG_FILE_PATH=akira-test.log

# Security
API_SECRET_KEY=test-secret-key
API_ACCESS_TOKEN=test-access-token

# Environment
ENVIRONMENT=testing
DEBUG=false
